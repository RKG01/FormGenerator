generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Form {
  id              Int           @id @default(autoincrement())
  ownerId         String
  createdAt       DateTime      @default(now())
  published       Boolean       @default(false)
  content         Json
  submissions     Int           @default(0)
  shareUrl        String        @default(uuid())
  aiSummary       String?
  
  // Integration fields
  webhookUrl             String?
  webhookEnabled         Boolean        @default(false)
  webhookStatus          String         @default("DISCONNECTED")
  webhookLastSync        DateTime?
  webhookLastSuccess     DateTime?

  notionApiKey           String?
  notionDatabaseId       String?
  notionEnabled          Boolean        @default(false)
  notionStatus           String         @default("DISCONNECTED")
  notionLastSync         DateTime?
  notionLastSuccess      DateTime?

  googleSheetUrl         String?
  googleSheetEnabled     Boolean        @default(false)
  googleSheetStatus      String         @default("DISCONNECTED")
  googleSheetLastSync    DateTime?
  googleSheetLastSuccess DateTime?

  FormSubmissions Submissions[]
  integrationLogs IntegrationLog[]
}

model IntegrationLog {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  formId          Int
  submissionId    Int
  integrationType String   // "WEBHOOK", "GOOGLE_SHEET", "NOTION"
  status          String   // "SUCCESS", "FAILED"
  message         String?
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model Submissions {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  formId    Int
  content   Json
  tags      String[] @default([])
  form      Form     @relation(fields: [formId], references: [id])
}

model Subscription {
  id         Int      @id @default(autoincrement())
  userId     String
  subscribed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
